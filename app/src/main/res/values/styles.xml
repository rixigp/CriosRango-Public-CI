<resources>
    <style name="Theme.CriosRango" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#111111</item>
        <item name="android:windowBackground">@color/startup_background</item>
        <item name="android:navigationBarColor">@color/startup_background</item>
        <item name="android:statusBarColor">@color/startup_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.CriosRango.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/startup_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/criosrango_symbol</item>
        <item name="postSplashScreenTheme">@style/Theme.CriosRango</item>
        <item name="android:statusBarColor">@color/startup_background</item>
        <item name="android:navigationBarColor">@color/startup_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
