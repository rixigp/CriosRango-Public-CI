<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Legacy preferences may contain plaintext credentials and delivery PII; never back them up. -->
    <exclude domain="sharedpref" path="criosrango.xml" />
    <exclude domain="sharedpref" path="criosrango_pending_claim_order.xml" />
    <exclude domain="sharedpref" path="criosrango_account_session.xml" />
    <exclude domain="sharedpref" path="criosrango_account_session_v2.xml" />
    <exclude domain="sharedpref" path="criosrango_pending_card_payment.xml" />
    <!-- Firebase Installations FID and installation auth state are per-installation. -->
    <exclude domain="file" path="PersistedInstallation.W0RFRkFVTFRd+MTo0MjE4ODk5ODM5MjE6YW5kcm9pZDpjOWY0NmRmMzQ0Y2E5OTdkN2IyOTkw.json" />
    <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
    <!-- Catalog Room database is a regenerable cache, not user-owned data. -->
    <exclude domain="database" path="criosrango_catalog.db" />
</full-backup-content>
